#!/bin/bash
set -o errexit
set -o pipefail

log::err() {
  printf "[$(date +'%Y-%m-%dT%H:%M:%S.%N%z')]: \033[31mERROR: \033[0m%s\n" "$*"
}

log::info() {
  printf "[$(date +'%Y-%m-%dT%H:%M:%S.%N%z')]: \033[32mINFO: \033[0m%s\n" "$*"
}

log::warning() {
  printf "[$(date +'%Y-%m-%dT%H:%M:%S.%N%z')]: \033[33mWARNING: \033[0m%s\n" "$*"
}

check_file() {
  if [[ ! -r ${1} ]]; then
    log::err "can not find ${1}"
    exit 1
  fi
}

base64_nowrap() {
  base64 "${1}" | tr -d '\n'
}

cert::get_subject_alt_name() {
  local cert=${1}.crt
  check_file "${cert}"
  openssl x509 -text -noout -in "${cert}" \
    | grep -A1 'Subject Alternative Name' \
    | tail -n1 \
    | sed 's/[[:space:]]*//g;s/IPAddress:/IP:/g'
}

cert::get_subj() {
  local cert=${1}.crt
  check_file "${cert}"
  openssl x509 -noout -subject -nameopt slash -in "${cert}" | sed 's/^subject=//'
}

cert::backup_file() {
  local file=${1}
  local backup=${file}.old-$(date +%Y%m%d)
  if [[ ! -e ${backup} ]]; then
    cp -rp "${file}" "${backup}"
    log::info "backup ${file} to ${backup}"
  else
    log::warning "does not backup, ${backup} already exists"
  fi
}

cert::gen_cert() {
  local cert_name=${1}
  local cert_type=${2}
  local subj=${3}
  local cert_days=${4}
  local alt_name=${5:-}
  local cert=${cert_name}.crt
  local key=${cert_name}.key
  local csr=${cert_name}.csr
  local csr_conf="distinguished_name = dn\n[dn]\n[v3_ext]\nkeyUsage = critical, digitalSignature, keyEncipherment\n"

  check_file "${key}"
  check_file "${cert}"

  case "${cert_type}" in
    client)
      openssl req -new -key "${key}" -subj "${subj}" -reqexts v3_ext \
        -config <(printf "${csr_conf} extendedKeyUsage = clientAuth\n") -out "${csr}"
      openssl x509 -in "${csr}" -req -CA "${CA_CERT}" -CAkey "${CA_KEY}" -CAcreateserial -extensions v3_ext \
        -extfile <(printf "${csr_conf} extendedKeyUsage = clientAuth\n") -days "${cert_days}" -out "${cert}"
      log::info "generated ${cert}"
    ;;
    server)
      openssl req -new -key "${key}" -subj "${subj}" -reqexts v3_ext \
        -config <(printf "${csr_conf} extendedKeyUsage = serverAuth\nsubjectAltName = ${alt_name}\n") -out "${csr}"
      openssl x509 -in "${csr}" -req -CA "${CA_CERT}" -CAkey "${CA_KEY}" -CAcreateserial -extensions v3_ext \
        -extfile <(printf "${csr_conf} extendedKeyUsage = serverAuth\nsubjectAltName = ${alt_name}\n") -days "${cert_days}" -out "${cert}"
      log::info "generated ${cert}"
    ;;
    peer)
      openssl req -new -key "${key}" -subj "${subj}" -reqexts v3_ext \
        -config <(printf "${csr_conf} extendedKeyUsage = serverAuth, clientAuth\nsubjectAltName = ${alt_name}\n") -out "${csr}"
      openssl x509 -in "${csr}" -req -CA "${CA_CERT}" -CAkey "${CA_KEY}" -CAcreateserial -extensions v3_ext \
        -extfile <(printf "${csr_conf} extendedKeyUsage = serverAuth, clientAuth\nsubjectAltName = ${alt_name}\n") -days "${cert_days}" -out "${cert}"
      log::info "generated ${cert}"
    ;;
    *)
      log::err "unknown cert type: ${cert_type}; supported types: client, server, peer"
      exit 1
  esac

  rm -f "${csr}"
}

cert::update_kubeconf() {
  local cert_name=${1}
  local kubeconf_file=${cert_name}.conf
  local cert=${cert_name}.crt
  local key=${cert_name}.key

  check_file "${kubeconf_file}"
  grep "client-key-data" "${kubeconf_file}" | awk '{print $2}' | base64 -d > "${key}"
  grep "client-certificate-data" "${kubeconf_file}" | awk '{print $2}' | base64 -d > "${cert}"

  local subj
  subj=$(cert::get_subj "${cert_name}")
  cert::gen_cert "${cert_name}" "client" "${subj}" "${CERT_DAYS}"

  local cert_base64
  cert_base64=$(base64_nowrap "${cert}")
  sed -i 's/client-certificate-data:.*/client-certificate-data: '"${cert_base64}"'/g' "${kubeconf_file}"

  log::info "generated new ${kubeconf_file}"
  rm -f "${cert}" "${key}"

  if [[ ${cert_name##*/} == "admin" ]]; then
    mkdir -p ~/.kube
    cp -fp "${kubeconf_file}" ~/.kube/config
    log::info "copy the admin.conf to ~/.kube/config for kubectl"
  fi
}

cert::update_kubeconf_if_exists() {
  local cert_name=${1}
  local kubeconf_file=${cert_name}.conf

  if [[ -f ${kubeconf_file} ]]; then
    cert::update_kubeconf "${cert_name}"
  else
    log::warning "skip ${kubeconf_file}, file does not exist"
  fi
}

runtime::restart_static_pod() {
  local pod_name=${1}
  if command -v crictl >/dev/null 2>&1; then
    crictl --runtime-endpoint "${RUNTIME_ENDPOINT}" ps --name "${pod_name}" -q \
      | xargs -r crictl --runtime-endpoint "${RUNTIME_ENDPOINT}" stop || true
  elif command -v docker >/dev/null 2>&1; then
    docker ps | awk "/k8s_${pod_name}/{print \$1}" | xargs -r docker restart || true
  else
    log::warning "neither crictl nor docker found; skip restarting ${pod_name}"
  fi
}

cert::update_etcd_cert() {
  local restart_apiserver=${1:-true}
  PKI_PATH=${KUBE_PATH}/pki/etcd
  CA_CERT=${PKI_PATH}/ca.crt
  CA_KEY=${PKI_PATH}/ca.key

  check_file "${CA_CERT}"
  check_file "${CA_KEY}"

  CERT_NAME=${PKI_PATH}/server
  subject_alt_name=$(cert::get_subject_alt_name "${CERT_NAME}")
  cert::gen_cert "${CERT_NAME}" "peer" "/CN=etcd-server" "${CERT_DAYS}" "${subject_alt_name}"

  CERT_NAME=${PKI_PATH}/peer
  subject_alt_name=$(cert::get_subject_alt_name "${CERT_NAME}")
  cert::gen_cert "${CERT_NAME}" "peer" "/CN=etcd-peer" "${CERT_DAYS}" "${subject_alt_name}"

  CERT_NAME=${PKI_PATH}/healthcheck-client
  cert::gen_cert "${CERT_NAME}" "client" "/O=system:masters/CN=kube-etcd-healthcheck-client" "${CERT_DAYS}"

  PKI_PATH=${KUBE_PATH}/pki
  CERT_NAME=${PKI_PATH}/apiserver-etcd-client
  cert::gen_cert "${CERT_NAME}" "client" "/O=system:masters/CN=kube-apiserver-etcd-client" "${CERT_DAYS}"

  runtime::restart_static_pod "etcd"
  log::info "restarted etcd"
  if [[ "${restart_apiserver}" == "true" ]]; then
    runtime::restart_static_pod "kube-apiserver"
    log::info "restarted kube-apiserver"
  fi
}

cert::update_master_cert() {
  PKI_PATH=${KUBE_PATH}/pki
  CA_CERT=${PKI_PATH}/ca.crt
  CA_KEY=${PKI_PATH}/ca.key

  check_file "${CA_CERT}"
  check_file "${CA_KEY}"

  CERT_NAME=${PKI_PATH}/apiserver
  subject_alt_name=$(cert::get_subject_alt_name "${CERT_NAME}")
  cert::gen_cert "${CERT_NAME}" "server" "/CN=kube-apiserver" "${CERT_DAYS}" "${subject_alt_name}"

  CERT_NAME=${PKI_PATH}/apiserver-kubelet-client
  cert::gen_cert "${CERT_NAME}" "client" "/O=system:masters/CN=kube-apiserver-kubelet-client" "${CERT_DAYS}"

  cert::update_kubeconf "${KUBE_PATH}/controller-manager"
  cert::update_kubeconf "${KUBE_PATH}/scheduler"
  cert::update_kubeconf "${KUBE_PATH}/admin"
  cert::update_kubeconf_if_exists "${KUBE_PATH}/super-admin"

  set +e
  grep kubelet-client-current.pem "${KUBE_PATH}/kubelet.conf" >/dev/null 2>&1
  kubelet_cert_auto_update=$?
  set -e
  if [[ "${kubelet_cert_auto_update}" == "0" ]]; then
    log::warning "does not need to update kubelet.conf"
  else
    cert::update_kubeconf "${KUBE_PATH}/kubelet"
  fi

  CA_CERT=${PKI_PATH}/front-proxy-ca.crt
  CA_KEY=${PKI_PATH}/front-proxy-ca.key
  check_file "${CA_CERT}"
  check_file "${CA_KEY}"
  CERT_NAME=${PKI_PATH}/front-proxy-client
  cert::gen_cert "${CERT_NAME}" "client" "/CN=front-proxy-client" "${CERT_DAYS}"

  runtime::restart_static_pod "kube-apiserver"
  log::info "restarted kube-apiserver"
  runtime::restart_static_pod "kube-controller-manager"
  log::info "restarted kube-controller-manager"
  runtime::restart_static_pod "kube-scheduler"
  log::info "restarted kube-scheduler"
  systemctl restart kubelet
  log::info "restarted kubelet"
}

main() {
  local node_type=${1:-}

  KUBE_PATH=${KUBE_PATH:-/etc/kubernetes}
  CERT_DAYS=${CERT_DAYS:-36500}
  RUNTIME_ENDPOINT=${RUNTIME_ENDPOINT:-unix:///run/containerd/containerd.sock}

  check_file "${KUBE_PATH}/pki/ca.crt"
  cert::backup_file "${KUBE_PATH}"

  case "${node_type}" in
    etcd)
      cert::update_etcd_cert true
    ;;
    master)
      cert::update_master_cert
    ;;
    all)
      cert::update_etcd_cert false
      cert::update_master_cert
    ;;
    *)
      log::err "unknown cert scope: ${node_type}; supported scopes: all, etcd, master"
      exit 1
    ;;
  esac
}

main "$@"
